# Database
DATABASE_URL=postgresql://pokedex:pokedex@localhost:5432/pokedex

# API
PORT=4000
NODE_ENV=development
JWT_ACCESS_SECRET=change-me-access-secret-min-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5177

# PokéAPI
POKEAPI_BASE_URL=https://pokeapi.co/api/v2
POKEAPI_CACHE_TTL_MS=600000

# Frontend (apps/web/.env)
VITE_API_URL=http://localhost:4000

# Optional: AI insights (bonus feature)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Docker Postgres
POSTGRES_USER=pokedex
POSTGRES_PASSWORD=pokedex
POSTGRES_DB=pokedex
