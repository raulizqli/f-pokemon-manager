@baseUrl = http://localhost:4000

### Health
GET {{baseUrl}}/health

### Register
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "trainer@example.com",
  "password": "password123",
  "displayName": "Trainer Red"
}

### Login
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "trainer@example.com",
  "password": "password123"
}

### Me
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{login.response.body.accessToken}}

### List Pokémon
GET {{baseUrl}}/api/pokemon?limit=10&offset=0

### Search Pokémon
GET {{baseUrl}}/api/pokemon?search=pika&limit=10

### Pokémon Detail
GET {{baseUrl}}/api/pokemon/25

### Add to Collection
# Server rolls isShiny with 30% chance; response includes isShiny + shiny sprite when applicable
POST {{baseUrl}}/api/collection
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "pokemonId": 25,
  "nickname": "Sparky",
  "status": "caught",
  "notes": "My first Pokémon!"
}

### List Collection
GET {{baseUrl}}/api/collection
Authorization: Bearer {{login.response.body.accessToken}}

### Collection Stats
GET {{baseUrl}}/api/collection/stats
Authorization: Bearer {{login.response.body.accessToken}}

### List Trainers
GET {{baseUrl}}/api/users?search=
Authorization: Bearer {{login.response.body.accessToken}}

### Trainer Collection
GET {{baseUrl}}/api/users/{{recipientId}}/collection
Authorization: Bearer {{login.response.body.accessToken}}

### Propose Trade
POST {{baseUrl}}/api/trades
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "recipientId": "{{recipientId}}",
  "offeredEntryId": "{{offeredEntryId}}",
  "requestedEntryId": "{{requestedEntryId}}"
}

### List Trades
GET {{baseUrl}}/api/trades
Authorization: Bearer {{login.response.body.accessToken}}

### Accept Trade
POST {{baseUrl}}/api/trades/{{tradeId}}/accept
Authorization: Bearer {{login.response.body.accessToken}}

### Reject Trade
POST {{baseUrl}}/api/trades/{{tradeId}}/reject
Authorization: Bearer {{login.response.body.accessToken}}

### Cancel Trade
POST {{baseUrl}}/api/trades/{{tradeId}}/cancel
Authorization: Bearer {{login.response.body.accessToken}}

### AI Status
GET {{baseUrl}}/api/ai/status
Authorization: Bearer {{login.response.body.accessToken}}

### AI Insights
POST {{baseUrl}}/api/ai/insights
Authorization: Bearer {{login.response.body.accessToken}}

### Logout
POST {{baseUrl}}/api/auth/logout
Content-Type: application/json

{
  "refreshToken": "{{login.response.body.refreshToken}}"
}
